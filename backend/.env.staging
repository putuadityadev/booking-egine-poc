APP_NAME="Booking Engine POC API (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-booking.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Membership Platform Integration (Staging OAuth 2.1)
# --------------------------------------------------------------------------
# Fill with your staging Membership API URL, tenant domain, and credentials
MEMBERSHIP_API_URL=
MEMBERSHIP_TENANT_DOMAIN=
MEMBERSHIP_CLIENT_ID=
MEMBERSHIP_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Cloudflare Tunnel & Proxy Settings
# --------------------------------------------------------------------------
# CF Tunnel domain (ganti sesuai tunnel aktif kamu)
APP_URL=https://your-tunnel.trycloudflare.com

# CORS — Frontend origin yang diizinkan (pisah koma jika banyak)
# Contoh: https://your-frontend.trycloudflare.com,https://localhost:5173
CORS_ALLOWED_ORIGINS=*

# Session config untuk HTTPS (CF tunnel selalu HTTPS)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# Sanctum — tambahkan CF tunnel domain agar stateful request work
SANCTUM_STATEFUL_DOMAINS=your-tunnel.trycloudflare.com,localhost,localhost:5173

# --------------------------------------------------------------------------
# Queue — Pastikan cron scheduler bisa berjalan
# --------------------------------------------------------------------------
QUEUE_CONNECTION=sync
